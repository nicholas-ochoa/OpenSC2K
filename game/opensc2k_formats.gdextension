[configuration]

entry_symbol = "opensc2k_formats_init"
compatibility_minimum = 4.7
reloadable = false

[libraries]

macos.debug = "res://bin/opensc2k_formats/macos/libopensc2k_formats.dylib"
macos.release = "res://bin/opensc2k_formats/macos/libopensc2k_formats.dylib"
linux.debug.x86_64 = "res://bin/opensc2k_formats/linux-x86_64/libopensc2k_formats.so"
linux.release.x86_64 = "res://bin/opensc2k_formats/linux-x86_64/libopensc2k_formats.so"
linux.debug.arm64 = "res://bin/opensc2k_formats/linux-arm64/libopensc2k_formats.so"
linux.release.arm64 = "res://bin/opensc2k_formats/linux-arm64/libopensc2k_formats.so"
windows.debug.x86_64 = "res://bin/opensc2k_formats/windows-x86_64/opensc2k_formats.dll"
windows.release.x86_64 = "res://bin/opensc2k_formats/windows-x86_64/opensc2k_formats.dll"
windows.debug.arm64 = "res://bin/opensc2k_formats/windows-arm64/opensc2k_formats.dll"
windows.release.arm64 = "res://bin/opensc2k_formats/windows-arm64/opensc2k_formats.dll"
