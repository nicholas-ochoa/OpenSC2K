#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 518"
msgstr "{{paragraph}}{{random_table:132}}: \"Letz{{phrase:7}} Woche wurde meine Wohnung ausgeraubt. Die Polizei brauch{{phrase:7}} zwei geschlagene Stunden, bis sie endlich kam!\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 519"
msgstr "{{paragraph}}{{random_table:131}}: \"Nu ja, als ich aus dem K{{phrase:6}}st raus war, habe ich keinen Mist mehr gebaut.\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 520"
msgstr "{{paragraph}}{{random_table:131}}: \"Nein, aber meiner Schwes{{phrase:7}}r wurde {{phrase:5}} einiger Zeit ihr Auto geklaut. {{random_number:10}} Mona{{phrase:7}} spä{{phrase:7}}r wurde es wieder gefunden -- total ausgeschlach{{phrase:7}}t.\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 521"
msgstr "{{paragraph}}{{random_table:132}}: \"Allerdings. Letz{{phrase:7}}s Wochenende wurde mir meine H{{phrase:6}}dtasche im Einaufszentrum vom Arm gerissen. Ich habe es sofort gemeldet, aber die Polizei kam gar nicht erst.\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 522"
msgstr "{{paragraph}}{{random_table:131}}: \"Vor einer Woche beobach{{phrase:7}}{{phrase:7}} ich auf dem Weg zur Arbeit, wie jem{{phrase:6}}d Unfallflucht beging. Meinen Sie sowas?\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 523"
msgstr "{{paragraph}}{{random_table:131}}: \"Ges{{phrase:7}}rn nacht auf dem Heimweg von der Arbeit drück{{phrase:7}} mir plötzlich ein M{{phrase:6}}n eine Pistole zwischen die Rippen und verl{{phrase:6}}g{{phrase:7}} meinen Geldbeu{{phrase:7}}l und meine Armb{{phrase:6}}duhr. Ich suche mir jetzt eine {{phrase:6}}dere Arbeitss{{phrase:7}}lle-- der Weg ist bei Dunkelheit einfach zu gefährlich.\" "

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 524"
msgstr "{{paragraph}}{{random_table:131}}: \"Aus unserer Garage sind neulich sämtliche Werkzeuge gestohlen worden. Und dabei waren wir sogar zuhause! Diese Dreistheit ist schon unglaublich. Die Kriminellen wissen eben, daß sie nichts riskieren -- bei der Polizei muß m{{phrase:6}} sowieso erst zehnmal {{phrase:6}}klingeln, be{{phrase:5}} jem{{phrase:6}}d {{phrase:1}} Telefon abhebt.\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 525"
msgstr "{{paragraph}}{{random_table:176}}: \"In unserer Straße gab es letz{{phrase:7}} Woche eine Schießerei. Zum Glück wurde niem{{phrase:6}}d verletzt, aber es hat uns allen einen Schrecken eingejagt.\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 526"
msgstr "{{paragraph}}{{random_table:132}}: \"Nein, aber es kommt mir so {{phrase:5}}, als gebe es viel mehr zwielichtige Gestal{{phrase:7}}n auf unseren Straßen als früher. Ich fühle mich einfach nicht mehr sicher.\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 527"
msgstr "{{paragraph}}{{random_table:131}}: \"Ich nicht, aber alle meine Nachbarn. Wir versuchen uns durch gegenseitiges Aufpassen zu schützen. Ich wünsch{{phrase:7}} nur, die Polizei tä{{phrase:7}} {{phrase:1}} ihre.\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 528"
msgstr "{{paragraph}}{{random_table:131}}: \"Ges{{phrase:7}}rn abend, als ich {{phrase:3}} ein paar Freunden aus dem Kino kam, hatten zwei unserer Autos eingeschlagene Fens{{phrase:7}}rscheiben. So ein Autofens{{phrase:7}}r kos{{phrase:7}}t heu{{phrase:7}} glatt 200 Mark!\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 529"
msgstr "{{paragraph}}{{random_table:131}}: \"Du Idiot! Hoch die Patschpfötchen! Sooodele, da sind ja die Mon{{phrase:2}}n...heda! Keine Fotos!!\""

