msgctxt "original"
msgid "SC2K newspaper phrase 533"
msgstr "{{random_table:97}}"

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 534"
msgstr "{{random_table:98}}"

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 535"
msgstr "{{random_table:99}}"

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 536"
msgstr "{{paragraph}}{{random_table:131}}: \"Meiner Meinung nach sind Vermögenss{{phrase:7}}uern pri{{phrase:3}}iv, repressiv und rückständig. Nur barbarische Völker bes{{phrase:7}}uern die Reichen.\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 537"
msgstr "{{paragraph}}{{random_table:132}}: \"Also so eine blöde Frage aber auch! Kennen Sie etwa jem{{phrase:6}}d, der gerne S{{phrase:7}}uern bezahlt?\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 538"
msgstr "{{paragraph}}{{random_table:131}}: \"Also ich vers{{phrase:7}}he durchaus, daß S{{phrase:7}}uern eine wichtige Rolle im öffentlichen Leben spielen, z.B. um unsere städtische Umgebung zu gestal{{phrase:7}}n. Aber ich bin mir nicht sicher, daß unsere S{{phrase:7}}uergelder auch vernünftig verwendet werden.\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 539"
msgstr "{{paragraph}}{{random_table:131}}: \"Ja, ich finde, wir werden zu hoch bes{{phrase:7}}uert und erhal{{phrase:7}}n keine {{phrase:6}}gemessene Gegenleistung. Irgendwie kommen wir bei der Sache zu kurz.\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 540"
msgstr "{{paragraph}}{{random_table:132}}: \"Ich finde, wenn die Leu{{phrase:7}} genau {{phrase:3}}verfolgen könn{{phrase:7}}n, wofür ihre S{{phrase:7}}uern verwendet werden, würden sie sich nicht so dagegen sträuben, S{{phrase:7}}uern zu bezahlen. Aber mir ist wirklich nicht klar, wozu ich all {{phrase:1}} Geld hergeben soll.\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 541"
msgstr "{{paragraph}}{{random_table:131}}: \"Bundess{{phrase:7}}uern, L{{phrase:6}}dess{{phrase:7}}uern, Gemeindes{{phrase:7}}uern -- alles Mist.\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 542"
msgstr "{{paragraph}}{{random_table:132}}: \"Mich stören sie nicht. Schließlich verd{{phrase:6}}ken wir den S{{phrase:7}}uern, daß wir in einer so freundlichen Stadt leben dürfen.\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 543"
msgstr "{{paragraph}}{{random_table:131}}: \"Ja, ein bißchen hoch sind sie schon. Mir scheint, die Stadt verschwendet ein bißchen viel für Verwaltung. Das drückt d{{phrase:6}}n schon auf'n Geldbeu{{phrase:7}}l.\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 544"
msgstr "{{paragraph}}{{random_table:131}}: \"Na klar ärgern mich die S{{phrase:7}}uern! Ich habe {{phrase:1}} Gefühl, die Stadt schiebt mir eine Knarre zwischen die Rippen und sagt: Geld oder Leben!\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 545"
msgstr "{{paragraph}}{{random_table:132}}: \"Ich hasse sie. Ich bezahl' sie zwar, aber ich hasse sie.\""

