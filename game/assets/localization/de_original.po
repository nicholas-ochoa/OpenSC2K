msgstr "{{random_table:98}}"

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 551"
msgstr "{{random_table:99}}"

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 552"
msgstr "{{paragraph}}{{random_table:131}}: \"Da haben Sie gerade den Richtigen erwischt. Ich wohne schon seit fast zwei Jahren hier in diesem Kühlschr{{phrase:6}}kkarton.\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 553"
msgstr "{{paragraph}}{{random_table:131}}: \"{{random_table:175}} auf dem Weg zur Arbeit sah ich eine ziemlich gepflegt und  gebildet aussehende Dame am Straßenr{{phrase:6}}d s{{phrase:7}}hen, so Anf{{phrase:6}}g vierzig, die hielt ein Schild in der H{{phrase:6}}d: \"Arbei{{phrase:7}} für Lebens{{phrase:3}}{{phrase:7}}l\". Als ich acht Stunden spä{{phrase:7}}r wieder heimfuhr, war sie immer noch da.\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 554"
msgstr "{{paragraph}}{{random_table:132}}: \"Ich kenne eine Frau, die einen Doktorti{{phrase:7}}l hat und für acht Mark die Stunde als Empf{{phrase:6}}gsdame arbei{{phrase:7}}t. Sie sagt, sie ist heilfroh, überhaupt Arbeit zu haben.\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 555"
msgstr "{{paragraph}}{{random_table:131}}: \"Meine Frau arbei{{phrase:7}}t seit ihrer Entlassung {{phrase:5}} einem Jahr als freie Schrifts{{phrase:7}}llerin, und sie hat jetzt mehr Arbeit als damals. Allerdings, leben k{{phrase:6}}n m{{phrase:6}} davon auch nicht.\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 556"
msgstr "{{paragraph}}{{random_table:131}}: \"Ich bin {{phrase:5}} 9 Mona{{phrase:7}}n entlassen worden. Meine Frau ist ebenfalls arbeitslos. Mit Hilfe unserer Ersparnisse und unserer mageren Arbeitslosenun{{phrase:7}}rstützung schaffen wir es gerade eben. Die Arbeitslosenhilfe läuft aber in drei Mona{{phrase:7}}n aus, und wir haben noch keine Ahnung, was wir d{{phrase:6}}n machen.\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 557"
msgstr "{{paragraph}}{{random_table:132}}: \"Ich habe zwei Unidiplome, und wissen Sie, was ich mache? Ich arbei{{phrase:7}} als Kellnerin. Aber wenigs{{phrase:7}}n k{{phrase:6}}n ich so meine Mi{{phrase:2}} bezahlen.\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 558"
msgstr "{{paragraph}}{{random_table:132}}: \"Es ist einfach extrem schwierig, Arbeit zu finden. Es gibt keine einzige Beschäftigung, die m{{phrase:6}} ohne wei{{phrase:7}}res haben könn{{phrase:7}}. Sogar Putzfrauen gibts noch und nöcher."

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 559"
msgstr "{{paragraph}}{{random_table:132}}: \"Um diese Frage zu be{{phrase:6}}two{{phrase:4}}n, brauchen Sie bloß mal tagsüber während der normalen Arbeitszei{{phrase:7}}n durch die Wohngebi{{phrase:2}} fahren. Sie werden eine Menge Leu{{phrase:7}} zuhause finden -- und zwar nicht deshalb, weil denen nichts besseres zu tun einfällt.\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 560"
msgstr "{{paragraph}}{{random_table:131}}: \"Mein sechsundzw{{phrase:6}}zigjähriger Sohn hat sich für einen neuen Studieng{{phrase:6}}g {{phrase:6}} der Uni eingeschrieben, weil er {{phrase:6}}derthalb Jahre l{{phrase:6}}g vergeblich nach Arbeit gesucht hat. Auf diese Weise nutzt er wenigs{{phrase:7}}ns seine Zeit.\""

#. German newspaper wording; named markers preserve the original substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 561"
msgstr "{{paragraph}}{{random_table:132}}: \"Unsere Toch{{phrase:7}}r von dreißig Jahren und ihr M{{phrase:6}}n sind gerade bei uns eingezogen, weil sie beide ihre Arbeitss{{phrase:7}}llen verloren haben. In einer derartigen Lage k{{phrase:6}}n m{{phrase:6}} doch die Kinder nicht im Stich lasen!\""

