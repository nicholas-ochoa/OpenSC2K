#. Original es newspaper phrase 746; named markers preserve substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 746"
msgstr " {{random_table:91}}"

#. Original es newspaper phrase 747; named markers preserve substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 747"
msgstr " {{random_table:93}}"

#. Original es newspaper phrase 748; named markers preserve substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 748"
msgstr ""
"{{paragraph}}{{random_table:166}}:  “los manicomios están llenos, llenos. "
"por eso me tuvieron que soltar! oye, dónde vas?”"

#. Original es newspaper phrase 749; named markers preserve substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 749"
msgstr ""
"{{paragraph}}{{random_table:166}}:  “salud pública? no me hable de algo que "
"no funciona en {{random_table:143}}.”"

#. Original es newspaper phrase 750; named markers preserve substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 750"
msgstr ""
"{{paragraph}}{{random_table:166}}:  “por suerte estoy bien de salud. pero el"
" que asista a un hospital de {{random_table:143}} se llevará una "
"desagradable sorpresa.”"

#. Original es newspaper phrase 751; named markers preserve substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 751"
msgstr ""
"{{paragraph}}{{random_table:166}}:  “creo que {{random_table:143}} nos ha "
"enviado un mensaje fuerte y claro. atender a las necesidades de los médicos "
"es asunto nuestro!”"

#. Original es newspaper phrase 752; named markers preserve substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 752"
msgstr ""
"{{paragraph}}{{random_table:166}}:  “por suerte, en mi trabajo tenemos un "
"dispensario médico. pero tengo amigos que dependen de los servicios de la "
"ciudad y sé lo mal que lo pasan.”"

#. Original es newspaper phrase 753; named markers preserve substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 753"
msgstr ""
"{{paragraph}}{{random_table:166}}:  “el problema es que no hay recursos para"
" todos los ciudadanos que necesitan atención. la población se enferma porque"
" no recibe el servicio requerido.”"

#. Original es newspaper phrase 754; named markers preserve substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 754"
msgstr ""
"{{paragraph}}{{random_table:166}}:  “con la cantidad de pacientes que "
"nuestros médicos deben atender, lo raro es que no hayan muerto de "
"agotamiento.”"

#. Original es newspaper phrase 755; named markers preserve substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 755"
msgstr ""
"{{paragraph}}{{random_table:166}}:  “no he tenido una buena experiencia con "
"la salud pública de {{city}}."

#. Original es newspaper phrase 756; named markers preserve substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 756"
msgstr ""
"{{paragraph}}{{random_table:166}}:  “los servicios médicos de "
"{{random_table:143}}  son buenos para curar un resfriado, pero nada más.”"

#. Original es newspaper phrase 757; named markers preserve substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 757"
msgstr ""
"{{paragraph}}{{random_table:166}}:  “mi suegra murió por negligencias. cosas"
" como esa no deberían de ocurrir. por supuesto, hemos demandado a los "
"médicos.”"

#. Original es newspaper phrase 758; named markers preserve substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 758"
msgstr ""
"{{paragraph}}{{random_table:166}}:  “cuando mi madre y yo tuvimos "
"{{random_table:156}}, fuimos al médico. cuando nos hicieron los análisis, el"
" enfermero se equivocó y la sangre nos salpicó. fue bochornoso.”"

#. Original es newspaper phrase 759; named markers preserve substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 759"
msgstr ""
"{{paragraph}}{{random_table:166}}:  “soy fuerte como un roble y tengo 80 "
"años. bebo a diario y fumo como una chimenea. me río de los médicos.”"

#. Original es newspaper phrase 760; named markers preserve substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 760"
msgstr ""
"{{paragraph}}{{random_table:166}}:  “mi médico es amable y competente. "
"resulta caro, pero eso es normal.”"

