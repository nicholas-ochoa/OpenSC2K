msgctxt "original"
msgid "SC2K newspaper phrase 114"
msgstr ""
"{{shared_table:203}} vão {{shared_table:129}} "
"{{shared_table:204}}{{section}}{{paragraph}}Os {{shared_table:203}} "
"{{shared_table:130}} o alvo {{shared_table:204}} em "
"{{saved_table_first:151}} ontem, deixando claras suas intenções de caráter "
"{{random_table:132}}. Os {{shared_table:203}} assumiram {{random_table:134}}"
" a responsabilidade pelas {{random_number:50}}5 mortes e pelos "
"{{random_number:53}}0 feridos, declarando à imprensa: \"Temos poder para "
"conseguir o que queremos, e esta é nossa maneira de pedir.\"{{paragraph}}O "
"{{shared_table:175}} de {{saved_table_first:151}} não comentou a situação, "
"mas um {{random_table:189}} e amigo pessoal confirmou que o "
"{{shared_table:175}} {{saved_table_second:164}}, defensor da estratégia "
"militar \"Meu pai bate no seu\", pretende retaliar.{{paragraph}}Sem dúvida, "
"o {{shared_table:175}} deixará os problemas de {{random_table:182}} de lado "
"por algum tempo. {{random_table:77}}"

#. Supplementary Brazilian Portuguese translation from English; supplied CD
#. newspaper data is English.
msgctxt "original"
msgid "SC2K newspaper phrase 115"
msgstr ""
"{{shared_table:203}} em episódio "
"{{random_table:132}}{{section}}{{paragraph}}{{saved_table_first:151}} "
"{{random_table:119}} ontem que apoia seus {{shared_table:203}}. Nos esforços"
" de manutenção da paz, os {{shared_table:203}} {{random_table:130}} o alvo "
"{{random_table:204}} da oposição. Segundo relataram, essa era a única "
"maneira pela qual se {{random_table:114}} evitar hostilidades.{{paragraph}}O"
" {{shared_table:175}} {{saved_table_second:164}}, {{random_table:132}} com a"
" notícia, esbravejou: \"{{random_table:148}} {{random_table:149}} a raiz de "
"toda essa violência.\" Seu único filho, {{random_table:161}}, concordou. As "
"ações certamente provocarão mais violência, talvez sob comando do próprio "
"{{shared_table:175}}, de jeito {{random_table:131}}. "
"{{random_table:77}}{{random_table:77}}"

