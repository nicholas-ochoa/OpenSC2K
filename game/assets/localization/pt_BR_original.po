msgctxt "original"
msgid "SC2K newspaper phrase 174"
msgstr ""
"{{shared_table:169}} lugar em {{shared_table:153}}{{section}}{{paragraph}}Um"
" {{shared_table:200}} governamental sobre delegacias de toda a SimNação "
"revelou que {{city}} ocupa o {{shared_table:169}} lugar nos casos de "
"{{shared_table:153}}. Isso coloca {{city}} entre os {{random_table:187}} por"
" cento com maior incidência desse crime.{{paragraph}}\"É uma anomalia "
"estatística\", {{random_table:119}} o chefe {{random_table:166}} "
"{{random_table:134}}, \"e a responsabilidade é do meu antecessor. Além "
"disso, o {{random_table:200}} foi manipulado contra "
"mim.\"{{paragraph}}{{random_table:166}}, autor do {{shared_table:200}}, "
"disse que vários fatores elevam os índices de {{shared_table:153}}: "
"\"Incluem incompetência policial, disponibilidade de alvos e locais do tipo "
"{{random_table:168}} com aspecto "
"{{random_table:131}}.\"{{random_table:77}}{{random_table:77}}"

