[configuration]

entry_symbol = "opensc2k_simulation_init"
compatibility_minimum = 4.7
reloadable = false

[libraries]

macos.debug = "res://bin/opensc2k_simulation/macos/libopensc2k_simulation.dylib"
macos.release = "res://bin/opensc2k_simulation/macos/libopensc2k_simulation.dylib"
linux.debug.x86_64 = "res://bin/opensc2k_simulation/linux-x86_64/libopensc2k_simulation.so"
linux.release.x86_64 = "res://bin/opensc2k_simulation/linux-x86_64/libopensc2k_simulation.so"
linux.debug.arm64 = "res://bin/opensc2k_simulation/linux-arm64/libopensc2k_simulation.so"
linux.release.arm64 = "res://bin/opensc2k_simulation/linux-arm64/libopensc2k_simulation.so"
windows.debug.x86_64 = "res://bin/opensc2k_simulation/windows-x86_64/opensc2k_simulation.dll"
windows.release.x86_64 = "res://bin/opensc2k_simulation/windows-x86_64/opensc2k_simulation.dll"
