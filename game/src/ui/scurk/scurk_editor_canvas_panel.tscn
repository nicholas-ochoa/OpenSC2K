[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/scurk/scurk_editor_canvas_panel.gd" id="script"]
[ext_resource type="Script" path="res://src/view/scurk_pixel_canvas.gd" id="pixels"]
[ext_resource type="Script" path="res://src/view/scurk_view_preview.gd" id="preview"]

[node name="Canvas" type="VBoxContainer"]
script = ExtResource("script")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3

[node name="PixelScroll" type="ScrollContainer" parent="Row"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Center" type="CenterContainer" parent="Row/PixelScroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="PixelCanvas" type="Control" parent="Row/PixelScroll/Center"]
layout_mode = 2
script = ExtResource("pixels")

[node name="Previews" type="PanelContainer" parent="Row"]
layout_mode = 2
visible = false

[node name="Content" type="VBoxContainer" parent="Row/Previews"]
layout_mode = 2

[node name="Scroll" type="ScrollContainer" parent="Row/Previews/Content"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Views" type="VBoxContainer" parent="Row/Previews/Content/Scroll"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Original" type="HBoxContainer" parent="Row/Previews/Content/Scroll/Views"]
layout_mode = 2
alignment = 1

[node name="Large" type="VBoxContainer" parent="Row/Previews/Content/Scroll/Views/Original"]
layout_mode = 2

[node name="Preview" type="Control" parent="Row/Previews/Content/Scroll/Views/Original/Large"]
layout_mode = 2
script = ExtResource("preview")
crop_to_artwork = true
size_label = "Large"

[node name="Smaller" type="VBoxContainer" parent="Row/Previews/Content/Scroll/Views/Original"]
layout_mode = 2

[node name="Medium" type="VBoxContainer" parent="Row/Previews/Content/Scroll/Views/Original/Smaller"]
layout_mode = 2

[node name="Preview" type="Control" parent="Row/Previews/Content/Scroll/Views/Original/Smaller/Medium"]
layout_mode = 2
script = ExtResource("preview")
crop_to_artwork = true
size_label = "Medium"

[node name="Small" type="VBoxContainer" parent="Row/Previews/Content/Scroll/Views/Original/Smaller"]
layout_mode = 2

[node name="Preview" type="Control" parent="Row/Previews/Content/Scroll/Views/Original/Smaller/Small"]
layout_mode = 2
script = ExtResource("preview")
crop_to_artwork = true
size_label = "Small"

[node name="LargeDouble" type="VBoxContainer" parent="Row/Previews/Content/Scroll/Views"]
layout_mode = 2

[node name="Preview" type="Control" parent="Row/Previews/Content/Scroll/Views/LargeDouble"]
layout_mode = 2
script = ExtResource("preview")
preview_scale = 2
crop_to_artwork = true
size_label = "Large x2"

[node name="Toggles" type="GridContainer" parent="Row/Previews/Content"]
layout_mode = 2
columns = 2

[node name="Large" type="CheckBox" parent="Row/Previews/Content/Toggles"]
layout_mode = 2
text = "Large"
button_pressed = true

[node name="Medium" type="CheckBox" parent="Row/Previews/Content/Toggles"]
layout_mode = 2
text = "Medium"
button_pressed = true

[node name="Small" type="CheckBox" parent="Row/Previews/Content/Toggles"]
layout_mode = 2
text = "Small"
button_pressed = true

[node name="LargeDouble" type="CheckBox" parent="Row/Previews/Content/Toggles"]
layout_mode = 2
text = "Large x2"
button_pressed = true

[node name="Footer" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 8
theme_override_constants/margin_top = 4

[node name="Row" type="HFlowContainer" parent="Footer"]
layout_mode = 2
theme_override_constants/h_separation = 10

[node name="Clipping" type="HBoxContainer" parent="Footer/Row"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Limit" type="CheckBox" parent="Footer/Row/Clipping"]
layout_mode = 2
text = "Clip to tile"
button_pressed = true

[node name="Clip" type="CheckBox" parent="Footer/Row/Clipping"]
layout_mode = 2
text = "Show clip region"

[node name="Terrain" type="CheckBox" parent="Footer/Row/Clipping"]
layout_mode = 2
text = "Show terrain"
button_pressed = true
tooltip_text = "Show the background terrain beneath the artwork."

[node name="Compare" type="HBoxContainer" parent="Footer/Row"]
layout_mode = 2

[node name="Label" type="Label" parent="Footer/Row/Compare"]
layout_mode = 2
text = "Compare"

[node name="Mode" type="OptionButton" parent="Footer/Row/Compare"]
layout_mode = 2
tooltip_text = "Compare with saved artwork. Hold Backslash for a quick view of the saved artwork."

[node name="Views" type="HBoxContainer" parent="Footer/Row"]
layout_mode = 2
size_flags_horizontal = 8
theme_override_constants/separation = 10

[node name="Context" type="Button" parent="Footer/Row/Views"]
layout_mode = 2
size_flags_vertical = 0
text = "Preview in Context..."

[node name="ShowViews" type="Button" parent="Footer/Row/Views"]
layout_mode = 2
size_flags_vertical = 0
text = "Show all views"
toggle_mode = true
