[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/scurk/scurk_editor_object_panel.gd" id="script"]

[ext_resource type="PackedScene" path="res://src/ui/scurk/scurk_tile_selector.tscn" id="tiles"]

[node name="Objects" type="HBoxContainer"]
script = ExtResource("script")

[node name="Tiles" parent="." instance=ExtResource("tiles")]
layout_mode = 2

[node name="Browse" type="Button" parent="."]
layout_mode = 2
text = "Browse"
tooltip_text = "Browse tiles"

[node name="NameDialog" type="ConfirmationDialog" parent="."]
title = "Tile name"
size = Vector2i(360, 130)
exclusive = true

[node name="Content" type="VBoxContainer" parent="NameDialog"]
layout_mode = 2

[node name="Name" type="LineEdit" parent="NameDialog/Content"]
layout_mode = 2
placeholder_text = "Optional tile name"

[node name="Revert" type="Button" parent="NameDialog/Content"]
layout_mode = 2
text = "Revert name"
