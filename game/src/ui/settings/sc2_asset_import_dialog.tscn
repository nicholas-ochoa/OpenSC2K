[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/settings/sc2_asset_import_dialog.gd" id="1_import"]

[node name="Sc2AssetImportDialog" type="Window"]
visible = true
title = "Import SimCity 2000 assets"
size = Vector2i(720, 520)
min_size = Vector2i(540, 420)
exclusive = true
script = ExtResource("1_import")

[node name="Background" type="PanelContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="Background"]
layout_mode = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 18

[node name="Content" type="VBoxContainer" parent="Background/Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Hint" type="Label" parent="Background/Margin/Content"]
layout_mode = 2
text = "Choose an installed game folder, a macOS .app, or extracted game files. Install GOG downloads first. Select all asset types or only those you want. Each import creates separate packs."
autowrap_mode = 3

[node name="SourceEdit" type="LineEdit" parent="Background/Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "Game folder or file"

[node name="Browse" type="HBoxContainer" parent="Background/Margin/Content"]
layout_mode = 2

[node name="BrowseFolder" type="Button" parent="Background/Margin/Content/Browse"]
unique_name_in_owner = true
layout_mode = 2
text = "Choose Folder…"

[node name="BrowseFile" type="Button" parent="Background/Margin/Content/Browse"]
unique_name_in_owner = true
layout_mode = 2
text = "Choose File…"

[node name="Categories" type="HBoxContainer" parent="Background/Margin/Content"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="GraphicsCheck" type="CheckBox" parent="Background/Margin/Content/Categories"]
unique_name_in_owner = true
layout_mode = 2
button_pressed = true
text = "Graphics"

[node name="SoundCheck" type="CheckBox" parent="Background/Margin/Content/Categories"]
unique_name_in_owner = true
layout_mode = 2
button_pressed = true
text = "Sounds"

[node name="MusicCheck" type="CheckBox" parent="Background/Margin/Content/Categories"]
unique_name_in_owner = true
layout_mode = 2
button_pressed = true
text = "Music"

[node name="BusyLabel" type="Label" parent="Background/Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Importing… Please keep this window open."

[node name="Progress" type="ProgressBar" parent="Background/Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
indeterminate = true
show_percentage = false

[node name="ResultText" type="TextEdit" parent="Background/Margin/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 140)
layout_mode = 2
size_flags_vertical = 3
editable = false
wrap_mode = 1
text = "Imported packs and any missing assets will be listed here."

[node name="Actions" type="HBoxContainer" parent="Background/Margin/Content"]
layout_mode = 2
alignment = 2

[node name="CloseButton" type="Button" parent="Background/Margin/Content/Actions"]
unique_name_in_owner = true
layout_mode = 2
text = "Close"

[node name="ImportButton" type="Button" parent="Background/Margin/Content/Actions"]
unique_name_in_owner = true
layout_mode = 2
text = "Import"
