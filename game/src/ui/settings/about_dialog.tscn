[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/settings/about_dialog.gd" id="1_about"]
[ext_resource type="Script" path="res://src/ui/settings/about_artwork.gd" id="2_artwork"]
[ext_resource type="FontFile" path="res://assets/fonts/rajdhani/Rajdhani-Light.ttf" id="3_light"]
[ext_resource type="FontFile" path="res://assets/fonts/rajdhani/Rajdhani-Bold.ttf" id="4_bold"]
[ext_resource type="PackedScene" path="res://src/ui/shared/frosted_dialog_backdrop.tscn" id="5_glass"]

[sub_resource type="FontVariation" id="FontVariation_title"]
base_font = ExtResource("4_bold")
variation_embolden = -0.2

[node name="AboutDialog" type="AcceptDialog"]
visible = true
title = "About OpenSC2K"
size = Vector2i(760, 550)
min_size = Vector2i(380, 200)
exclusive = true
dialog_text = "OpenSC2K is an open-source reimplementation of SimCity 2000 for Windows 95."
script = ExtResource("1_about")

[node name="Content" type="VBoxContainer" parent="."]

[node name="GameTitle" type="HBoxContainer" parent="Content"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 0

[node name="Open" type="Label" parent="Content/GameTitle"]
layout_mode = 2
theme_override_fonts/font = ExtResource("3_light")
theme_override_font_sizes/font_size = 64
text = "Open"
vertical_alignment = 2

[node name="SC2K" type="Label" parent="Content/GameTitle"]
layout_mode = 2
theme_override_fonts/font = SubResource("FontVariation_title")
theme_override_font_sizes/font_size = 70
text = "SC2K"
vertical_alignment = 2

[node name="Tabs" type="TabContainer" parent="Content"]
layout_mode = 2
size_flags_vertical = 3

[node name="About" type="HBoxContainer" parent="Content/Tabs"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Scene" type="VBoxContainer" parent="Content/Tabs/About"]
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
size_flags_vertical = 3

[node name="Artwork" type="Control" parent="Content/Tabs/About/Scene"]
layout_mode = 2
size_flags_vertical = 3
texture_filter = 1
mouse_filter = 2
script = ExtResource("2_artwork")

[node name="MissingArtwork" type="Label" parent="Content/Tabs/About/Scene"]
layout_mode = 2
text = "Import the original game files\nto see the scene."
horizontal_alignment = 1

[node name="Summary" type="RichTextLabel" parent="Content/Tabs/About"]
custom_minimum_size = Vector2(0, 0)
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
selection_enabled = true
text = "[b]OpenSC2K[/b]
An open-source reimplementation and modernization of SimCity 2000.

[b]Copyright © 2026 Nicholas Ochoa[/b]

OpenSC2K code is available under the MIT License. See Licenses and Credits for full license terms and third-party notices.

OpenSC2K incorporates fixes and implementation details adapted from the [url=https://github.com/sc2kfix/sc2kfix]sc2kfix project[/url], licensed under the [url=https://github.com/sc2kfix/sc2kfix/blob/main/LICENSE]MIT License[/url].

Built with Godot Engine and Godot WRY.
Title typography: Rajdhani by Indian Type Foundry.

[b]This project is unofficial and independent.[/b]
Not affiliated with, sponsored by, or endorsed by Electronic Arts or Maxis.

SimCity and SimCity 2000 are trademarks of their respective owners. Original game assets remain the property of their respective owners."

[node name="Licenses" type="VBoxContainer" parent="Content/Tabs"]
layout_mode = 2
metadata/_tab_name = "Licenses and credits"

[node name="LicensePicker" type="OptionButton" parent="Content/Tabs/Licenses"]
layout_mode = 2

[node name="LicenseText" type="RichTextLabel" parent="Content/Tabs/Licenses"]
layout_mode = 2
size_flags_vertical = 3
selection_enabled = true

[node name="FrostedBackdrop" parent="." instance=ExtResource("5_glass")]
