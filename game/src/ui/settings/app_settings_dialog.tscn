[node name="CompatibilityHint" type="Label" parent="Tabs/Compatibility/Fields"]
custom_minimum_size = Vector2(560, 0)
layout_mode = 2
text = "• Use original SC2 cities and SCN scenarios.
• New cities use the original 128 × 128 map and data grids.
• Larger maps and per-tile data maps are disabled.
• Fire uses the original update timing.
• Opening an SC2X city turns this option off automatically.
• SC2X cities cannot return to original compatibility.
• Graphics, audio, and interface improvements remain available."
autowrap_mode = 3

